# Required. Create one at https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Only used when you pass --proxy; connections are direct otherwise.
# A proxy changes the timings, so it is opt-in rather than automatic.
# DASHSCOPE_PROXY=http://127.0.0.1:10808

# Optional endpoint / model overrides.
# DASHSCOPE_HTTP_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# QWEN_FLASH_MODEL=qwen3-asr-flash-2026-02-10
# QWEN_REALTIME_MODEL=qwen3-asr-flash-realtime-2026-02-10
